# ============================================================
# MindBase —— 环境变量
# ------------------------------------------------------------
# 配置层级(由低到高,后者覆盖前者):
#   1. Pydantic 字段默认值
#   2. app/config/default.yaml
#   3. app/config/config.yaml             ← team-shared overrides (committed, optional)
#   4. app/config/local.yaml              ← personal overrides (.gitignore)
#   5. 环境变量(本文件)                   ← highest priority
#
# 命名规则:env 变量用 `双下划线` 嵌套到 YAML 字段
#   MINIO__ACCESS_KEY → minio.access_key
#   RDBMS__POOL_SIZE  → rdbms.pool_size
#
# ⚠️ 本文件只列 [敏感字段 + 必要的 SDK 直读变量]
#    所有非敏感配置(端口/超时/池大小/模型名等)请去 YAML 改,不要往这里塞
# ============================================================

# ============================================================
# 敏感字段(走 env / K8s Secret,YAML 永远不写)
# ============================================================

# ------------------------------------------------------------
# LLM —— 兼容 OpenAI 协议(默认走阿里云 DashScope)
# ------------------------------------------------------------
# 对应 YAML: llm.api_key
LLM__API_KEY=
# 如需覆盖 base_url / model,改 YAML 即可,无需在此重复

# ------------------------------------------------------------
# LLM Provider —— 对话类 LLM 网关切换(DashScope | OpenRouter)
# ------------------------------------------------------------
# 对应 YAML: llm.provider;解析逻辑见 app/services/llm/providers.py
# 仅影响对话类 LLM(chat agent / harness);embedding / rerank 仍走 DashScope
# LLM__PROVIDER=dashscope

# OpenRouter(OpenAI 兼容聚合网关),llm.provider=openrouter 时启用
# 对应 YAML: openrouter.api_key / openrouter.base_url / openrouter.model
# 模型名带厂商前缀,如 qwen/qwen3-max、anthropic/claude-sonnet-4.5
# OPENROUTER__API_KEY=

# ------------------------------------------------------------
# Session —— FastAPI session 签名密钥
# ------------------------------------------------------------
# 对应 YAML: session.secret
# 生成方式:python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION__SECRET=

# ------------------------------------------------------------
# 用户 API Key 加密密钥(32 字节,base64 编码)
# ------------------------------------------------------------
# 对应 YAML: security.api_key_encryption_key
# 生成方式:python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# ⚠️ 部署后不要修改此密钥,否则所有已存储的用户 API Key 将无法解密
SECURITY__API_KEY_ENCRYPTION_KEY=

# ------------------------------------------------------------
# CORS 允许的前端来源(逗号分隔)
# ------------------------------------------------------------
# 对应 YAML: security.cors.allow_origins
# 生产环境必须改为真实前端域名,禁止用 * (allow_credentials=True 时 * 会被
# Starlette 回显为请求 Origin,等于任意站点可携凭证跨域访问)
# SECURITY__CORS__ALLOW_ORIGINS=https://app.example.com,https://admin.example.com

# ------------------------------------------------------------
# 图形验证码(登录/密码重置/邮箱验证码发送的人机校验)
# ------------------------------------------------------------
# 对应 YAML: security.captcha.enabled(默认 true,Redis 不可用时自动降级放行)
# 本地开发/测试想跳过验证码时取消注释设为 false
# SECURITY__CAPTCHA__ENABLED=true

# ============================================================
# 可选基础设施敏感字段(只在 enabled=true 时需要)
# ============================================================

# ------------------------------------------------------------
# MongoDB(默认 enabled=false,启用后填)
# ------------------------------------------------------------
# 完整 URI(含密码)走这一项,YAML 里只列 host/port/db
# MONGO__URI=mongodb://user:pass@host:27017/mind_base

# ------------------------------------------------------------
# Redis(默认 enabled=false,启用后填)
# ------------------------------------------------------------
# REDIS__URL=redis://:password@host:6379/0
# REDIS__PASSWORD=

# ------------------------------------------------------------
# 微信扫码登录(开放平台网站应用 snsapi_login,默认 enabled=false)
# ------------------------------------------------------------
# 前提:企业认证的开放平台账号 + 已过审的「网站应用」;
# 本地联调可用开放平台「测试账号」(授权回调域支持 localhost)
# redirect_uri 指向前端回调页(不能在 /auth 前缀下,nginx 会转发给后端),
# 例如: http://localhost:3000/oauth/wechat/callback
# 对应 YAML: wechat.enabled / wechat.app_id / wechat.app_secret / wechat.redirect_uri
# WECHAT__ENABLED=true
# WECHAT__APP_ID=wx1234567890abcdef
# WECHAT__APP_SECRET=your_app_secret
# WECHAT__REDIRECT_URI=http://localhost:3000/oauth/wechat/callback

# ------------------------------------------------------------
# 阿里云短信(手机验证码注册/登录,默认 enabled=false)
# ------------------------------------------------------------
# 前提:阿里云短信服务 + 已审核签名/模板(模板需含 ${code} 参数,个人可用
# 公众号资质申请)。未配置时手机登录/注册入口自动隐藏(GET /auth/features
# 返回 sms_enabled=false),不影响其他登录方式。
# 对应 YAML: sms.enabled / sms.access_key_id / sms.access_key_secret /
# sms.sign_name / sms.template_code
# SMS__ENABLED=true
# SMS__ACCESS_KEY_ID=LTAI5txxxxxxxxxxxx
# SMS__ACCESS_KEY_SECRET=your_access_key_secret
# SMS__SIGN_NAME=MindBase
# SMS__TEMPLATE_CODE=SMS_123456789

# ------------------------------------------------------------
# MinIO(默认 enabled=false,启用后填)
# ------------------------------------------------------------
# MINIO__ACCESS_KEY=
# MINIO__SECRET_KEY=

# ------------------------------------------------------------
# Knowledge Graph(Neo4j,plan/1.0.5,默认 enabled=true 但连接失败自动降级)
# ------------------------------------------------------------
# docker 部署:uri 默认注入 bolt://neo4j:7687(compose 已处理),无需手动填
# 本地直连默认 bolt://localhost:7687;密码与 compose 的 neo4j 服务共享 NEO4J_PASSWORD
# KG__URI=bolt://localhost:7687
# NEO4J_PASSWORD=mind-base

# ------------------------------------------------------------
# Daytona(代码沙箱,code agent 用,默认 enabled=false)
# ------------------------------------------------------------
# DAYTONA__ENABLED=true
# DAYTONA__API_KEY=
# DAYTONA__API_URL=https://app.daytona.io/api
# DAYTONA__ORG_ID=
# DAYTONA__NETWORK_BLOCK_ALL=true            # 沙箱默认禁网（防数据外泄）
# DAYTONA__DOMAIN_ALLOW_LIST=*.pypi.org,github.com   # 白名单域名（可选放行）
# 代码执行记录持久化: code agent 每次 run_code 落库 MongoDB code_executions
# (关联 chat_session_id + assistant_msg_id), 产物存 MinIO code-artifacts/
# 依赖 MongoDB + MinIO 启用; 详见 docs/code-execution.md

# ------------------------------------------------------------
# Skill store(GitHub topic 市场,默认 enabled=false)
# 命名规则: 段__键 -> config["skill_store"]["key"]
# topic 标识 skill 仓库(仓库打该 topic 即上架);api_key 为 GitHub token(可选,提升搜索 rate limit)
# ------------------------------------------------------------
# SKILL_STORE__ENABLED=true
# SKILL_STORE__TOPIC=mindbase-skill
# SKILL_STORE__API_KEY=github_pat_xxx

# ------------------------------------------------------------
# RabbitMQ(默认 enabled=false,启用后填)
# ------------------------------------------------------------
# MQ__RABBITMQ_URL=amqp://user:pass@host:5672/

# ------------------------------------------------------------
# RDBMS —— 生产环境的真实连接串(连接池参数走 YAML)
# ------------------------------------------------------------
# 对应 YAML: rdbms.url(开发期 sqlite,生产期 PostgreSQL)
# RDBMS__URL=postgresql+asyncpg://user:pass@host:5432/mind_base

# ============================================================
# Rerank —— 两阶段检索的重排模型(默认关闭)
# ------------------------------------------------------------
# 启用后:embedding 召回 top_n=30 → 调 rerank 模型 → 切回 top_k=5
# 对应 YAML: rerank.*
# 模型/超时/top_n/top_k 走 default.yaml,本文件只放敏感开关
# ============================================================
# 对应 YAML: rerank.enabled
# RERANK__ENABLED=false   # default true (see default.yaml); set false to disable
# 对应 YAML: rerank.api_key —— 留空时自动 fallback 到 LLM__API_KEY
# (DashScope gte-rerank-v2 与主 LLM 同源时无需单独配)
# RERANK__API_KEY=

# ============================================================
# Eval Judge —— 离线评测时给答案打分的独立 LLM
# ------------------------------------------------------------
# 仅 `python -m app.test.eval.runner` 时使用,生产服务不依赖
# 设计上与被评测的主 LLM 隔离,避免同源偏倚(同一家模型给自己打分)
# 默认走 OpenAI gpt-4o-mini;改 base_url / model 见下
# ============================================================
# 必填:judge 调用的 API Key
# 解析顺序:JUDGE__API_KEY → OPENAI_API_KEY → LLM__API_KEY
# JUDGE__API_KEY=
# 可选:覆盖 judge 端点(默认 https://api.openai.com/v1)
# JUDGE__BASE_URL=https://api.openai.com/v1
# 可选:覆盖 judge 模型(默认 settings.eval_llm_model = gpt-4o-mini)
# JUDGE__MODEL=gpt-4o-mini

# ============================================================
# LangSmith —— LangChain SDK 直读以下变量(非我们 config 命名空间)
# ------------------------------------------------------------
# 启用 trace 必须三件套同时设置:
#   LANGCHAIN_TRACING_V2=true / LANGSMITH_TRACING=true / LANGSMITH_API_KEY=...
# 对应 YAML: langsmith.enabled(我们的代码用它判断是否包装 trace)
# ============================================================
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=MindBase
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# app-task -- 定时出题任务执行器(Go 独立服务,见 CLAUDE.md §2.7)
# ------------------------------------------------------------
# 前缀 APPTASK__,双下划线嵌套;读项目根 .env(godotenv)
# 本地开发:填下面;Docker:docker-compose environment 注入
# ============================================================

# ⚠️ app-task 使用独立 MySQL(库 app_task,schema 启动时 db.Migrate() 自建),不共享主 app 的库。
# 出题业务行 quiz_task/quiz_task_answer + 题库 Mongo task_quiz_questions 属主 app(executor 侧)。
# APPTASK__RDBMS__URL=mysql+aiomysql://app_task:app-task@127.0.0.1:3306/app_task

# app-task-mysql 独立实例(docker-compose app-task-mysql 服务)
# APPTASK_MYSQL_ROOT_PASSWORD=root123
# APPTASK_MYSQL_USER=app_task
# APPTASK_MYSQL_PASSWORD=app-task

# 调度:app-task 内置 DB 轮询 scheduler(30s 精度,无 xxl-job,重启自动恢复)

# ⚠️ 已废弃(Go 代码不再消费,勿再配置):出题任务的 executor_url/密钥随任务注册时指定,
# 由主 app /tasks/register 写入;APPTASK__APP__BASE_URL 与 APPTASK__APP__CONSUMER_KEY 无读取点。
# APPTASK__APP__BASE_URL=http://apisix:9080
# APPTASK__APP__CONSUMER_KEY=mindbase-internal-key-change-me

# 邮件(Resend,免费 100/天)
# ⚠️ 未配置 API key 时,邮件 worker 走 dry-run:notification 标 dry_run(不发邮件,状态可区分于 sent)。
# 生产必配,否则到点只出题不发邮件。另:from_email 默认用 onboarding@resend.dev 测试域名,只能发给账号自身,生产须换已验证域名。
APPTASK_EMAIL_API_KEY=
# APPTASK__EMAIL__API_KEY=re_xxx   # 与 APPTASK_EMAIL_API_KEY 二选一(后者优先)

# 时区(默认 Asia/Shanghai,嵌入 time/tzdata,trigger_time/deadline 存 UTC aware)
# APPTASK__TIMEZONE=Asia/Shanghai

# WebUI 控制台:登录 = 用户名+密码(账户存 webui_user 表,首次启动自动创建默认管理员
# admin / app-task-admin,登录后请在「账户」页改密;控制台始终需要登录)。
# 下面 APPTASK__WEBUI__TOKEN 是可选 master API 密钥(脚本/API 直接调 /api/*,等价 admin),非登录凭据。
# APPTASK__WEBUI__TOKEN=change-me
# APPTASK__WEBUI__SESSION_TTL_MINUTES=720   # 登录会话有效期(分钟)

# 日志(slog 结构化,经 internal/logger 包统一;详见 docs/app-task.md「日志」段)
# APPTASK__LOG__LEVEL=info            # debug/info/warn/error(app.debug=true 自动 debug)
# APPTASK__LOG__FORMAT=text           # text/json(json 适合生产日志聚合)
# APPTASK__LOG__OUTPUT=stdout         # stdout/file/both(docker 默认 both:stdout + 文件)
# APPTASK__LOG__FILE__PATH=/app/logs/app-task.log   # file/both 时用;docker 挂 app_task_logs volume
# APPTASK__LOG__FILE__MAX_SIZE=100    # 单文件 MB 上限,超则轮转
# APPTASK__LOG__FILE__MAX_BACKUPS=7   # 保留旧文件数
# APPTASK__LOG__FILE__MAX_AGE=30      # 保留天数
# APPTASK__LOG__FILE__COMPRESS=true   # gzip 旧文件

# ============================================================
# APISIX 网关(app-task + 主 app task-quiz agent 共用,见 apisix/)
# ------------------------------------------------------------
# key-auth consumer key(服务间调用 /internal/* /tasks/register 鉴权)
# ⚠️ 生产必改为真实 secret(主 app 的 APISIX_CONSUMER_KEY)
APISIX_CONSUMER_KEY=mindbase-internal-key-change-me

# 主 app task-quiz agent 调 app-task /tasks/register 的 base url(via APISIX)
# 方向:主 app -> app-task(与上方 APPTASK__APP__BASE_URL 方向相反,勿混)
# 本地 dev(APISIX 在 VM):http://192.168.138.128:9080;docker:http://apisix:9080
# APPTASK_BASE_URL=http://apisix:9080

# APISIX Admin API key(apisix/config.yaml admin_key;Admin API :9180 / dashboard 鉴权)
# ⚠️ 生产必改;standalone yaml 不支持 ${ENV} 插值,需在 config.yaml 直接写或部署时 sed 替换
# APISIX_ADMIN_KEY=admin-key-change-me

# ------------------------------------------------------------
# 入库并发(可选覆盖,默认见 config.yaml 的 ingest 段)
# ------------------------------------------------------------
# INGEST__PAGE_CONCURRENCY=3         # 收藏夹同步时分P 并发数(B站 SESSDATA 限流保守值)
# INGEST__ASR_CHUNK_CONCURRENCY=3    # 长音频 PCM 切块并行识别数(DashScope 并发限流)

# ============================================================
# docker-compose 自建镜像 tag(默认 :latest)
# ------------------------------------------------------------
# 固定 tag 每次重新构建会把旧镜像变成 <none>:<none> 悬空镜像并堆积占盘。
# 建议覆盖为版本化 tag(如 commit sha),或使用 scripts/docker-build.ps1
# (构建后自动 docker image prune -f 清理悬空镜像,不影响有 tag 的镜像)。
# BACKEND_IMAGE=ghcr.io/atoncooper/mind-base-backend:latest
# FRONTEND_IMAGE=ghcr.io/atoncooper/mind-base-frontend:latest
# APPTASK_IMAGE=ghcr.io/atoncooper/mind-base-app-task:latest
# ============================================================

# ============================================================
# 已废弃 —— 这些字段已迁移到 app/config/*.yaml
# ------------------------------------------------------------
# DASHSCOPE_API_KEY      → LLM__API_KEY(本文件)
# OPENAI_API_KEY         → LLM__API_KEY(本文件)
# OPENAI_BASE_URL        → llm.base_url(default.yaml)
# LLM_MODEL              → llm.model(default.yaml)
# EMBEDDING_MODEL        → embedding.model(default.yaml)
# EVAL_LLM_MODEL         → llm.eval_model(default.yaml)
# DASHSCOPE_BASE_URL     → asr.base_url(default.yaml)
# ASR_MODEL              → asr.model(default.yaml)
# ASR_TIMEOUT            → asr.timeout(default.yaml)
# ASR_MODEL_LOCAL        → asr.model_local(default.yaml)
# ASR_INPUT_FORMAT       → asr.input_format(default.yaml)
# APP_HOST               → server.host(default.yaml)
# APP_PORT               → server.port(default.yaml)
# DEBUG                  → app.debug(config.yaml)
# DATABASE_URL           → rdbms.url(default.yaml,生产走 RDBMS__URL env)
# CHUNK_TARGET_SIZE      → chunk.target_size(default.yaml)
# CHUNK_MIN_SIZE         → chunk.min_size(default.yaml)
# CHUNK_MAX_SIZE         → chunk.max_size(default.yaml)
# CHUNK_OVERLAP          → chunk.overlap(default.yaml)
# EMBEDDING_VERSION      → embedding.version(default.yaml)
# API_KEY_ENCRYPTION_KEY → SECURITY__API_KEY_ENCRYPTION_KEY(本文件)
# ============================================================
