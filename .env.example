# ================================================================
# MindBase .env — SECRETS ONLY
# ================================================================
# 原则：.env 只放"密钥/凭证"（密码、API key、token、加密密钥、带凭据的 DSN）。
# 其它配置（端口、开关、超时、资源上限、镜像 tag、域名、上游地址……）一律写在
# 配置文件里，不经过 .env：
#
#   - 部署接线（端口/资源上限/镜像/构建选择）：docker-compose*.yml 字面量
#   - 服务行为（阈值/开关/超时/路径）：各服务 default.yaml / application.yaml
#   - APISIX：apisix/config.yaml + apisix/apisix.yaml.template（渲染期占位符）
#   - 部署栈：deploy/<stack>/*.yml + 各自 README
#
# 需要改端口/开关/域名时，改对应配置文件（提交进 git），不要在 .env 里新增变量。
# 新增配置项请遵循 AGENTS.md §四：非敏感项进 YAML，只有密钥才进 .env 与本文件。
# ================================================================


# ----------------------------------------------------------------
# APISIX / 网关
# ----------------------------------------------------------------
# 服务间 M2M 共享 key（key-auth consumer "internal"；同时渲染进路由模板）
# 生成：openssl rand -hex 32  或 python -c "import secrets;print(secrets.token_urlsafe(36))"
APISIX_CONSUMER_KEY=
# Admin API / 内嵌 Dashboard 登录 key（HTTPS :9180 / 宿主 :19180）
APISIX_ADMIN_KEY=
# 支付域最小权限 key（只读会员查询 / 资金写操作），可选分离
PAY_READONLY_KEY=
PAY_OPS_KEY=
# app-pay /internal/* 的 X-Internal-Key（渲染进路由；留空回落 APISIX_CONSUMER_KEY）
PAY_INTERNAL_KEY=
# openresty 缓存 purge 令牌
PURGE_TOKEN=


# ----------------------------------------------------------------
# AI 网关 / LLM
# ----------------------------------------------------------------
# Higress consumer key（平台代发 LLM/embedding 请求的唯一凭证）
AI_GATEWAY__API_KEY=
# 可选：LangSmith 链路追踪（不开启则留空）
LANGSMITH_API_KEY=


# ----------------------------------------------------------------
# 数据库 / 中间件凭证
# ----------------------------------------------------------------
# 主库（共享 bilirag）：用户名与密码
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 主库 / 缓存 / 向量库 / 图库 DSN（含凭据）
RDBMS__URL=
REDIS__URL=
MILVUS__URI=
# app-task 专用库
APPTASK_MYSQL_PASSWORD=
APPTASK_MYSQL_ROOT_PASSWORD=
# app-pay 专用库
PAY_MYSQL_PASSWORD=
PAY_MYSQL_ROOT_PASSWORD=
# app-admin 支付运营只读/资金写连接（含凭据）
PAY_ADMIN_RDBMS_URL=
# Mongo
MONGO_PASSWORD=
MONGO__URI=
# Redis
REDIS_PASSWORD=
# Neo4j
NEO4J_PASSWORD=
# MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=


# ----------------------------------------------------------------
# 服务内部令牌（M2M 认证材料）
# ----------------------------------------------------------------
# 沙箱控制面 admin token（app-admin ↔ app-sandbox）
SANDBOX_ADMIN_TOKEN=
# OpenSandbox lifecycle server API key（app-sandbox ↔ opensandbox-server）
OPENSANDBOX_API_KEY=
# app-cloud ↔ app-kg 内部 token
APP_KG_INTERNAL_TOKEN=
# app-admin 分享审核受控预览 token（同时也是 app-cloud 的校验 token）
APP_CLOUD_ADMIN_REVIEW_TOKEN=
# app-cloud 分享下载/预览签名 secret
APP_CLOUD_ATTEST_SECRET=
# MinIO 事件通知 → app-cloud 的 webhook 校验 token
MINIO_EVENT_TOKEN=
# app-content-mcp 外部宿主 Bearer token（可选；服务模式不需要）
CONTENT_MCP_AUTH_TOKEN=
# 用户 API key 加密密钥（AES-256-GCM；app-user 与 app-task 共用）
SECURITY__API_KEY_ENCRYPTION_KEY=
# 可选：以文件形式提供同一密钥（FILE 优先于上面的内联值）
SECURITY__API_KEY_ENCRYPTION_KEY_FILE=


# ----------------------------------------------------------------
# 第三方渠道 / 邮件 / 短信
# ----------------------------------------------------------------
# Resend 邮件
APPTASK_EMAIL_API_KEY=
EMAIL__API_KEY=
# 阿里云短信
SMS__ACCESS_KEY_ID=
SMS__ACCESS_KEY_SECRET=
# 微信登录
WECHAT__APP_ID=
WECHAT__APP_SECRET=
# 支付宝（app-pay M2 渠道；enabled/gateway/notify 是 compose 字面量）
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_PUBLIC_KEY=
ALIPAY_PLATFORM_PUBLIC_KEY=
# app-task 超时委托 app-pay 的签名 token（deploy 栈使用）
PAY_EXECUTOR_TOKEN=
# 技能包对象存储签名 key（deploy/swarm 使用）
SKILL_STORE__API_KEY=
