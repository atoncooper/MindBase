# ============================================================
# MindBase - environment variables (.env)
# ------------------------------------------------------------
# Rule (mandatory): this file only holds SECRETS / SENSITIVE values:
#   - API keys / secrets / tokens / passwords / private keys
#   - Connection strings that embed credentials
#     (RDBMS__URL / MONGO__URI / REDIS__URL)
# Only two exception categories (see their own sections below):
#   - SDK-read variables (LangSmith and similar SDKs read env vars only,
#     never YAML)
#   - docker-compose interpolation variables (ports / image tags; compose
#     has no YAML mechanism)
# All normal configuration (switches / model names / timeouts / concurrency
# / URLs / paths / CORS ...) belongs in each service's own YAML, never here:
#   - app-ts          -> app-ts/src/config/ (default.yaml)
#   - app-go services -> app-go/<svc>/internal/config/default.yaml (embedded)
#   - app-pay         -> app-pay/src/main/resources/application*.yaml
# Sensitive fields in those YAMLs reference variables from this file via
# ${VAR} placeholders.
#
# Naming: double underscores map env vars onto nested YAML fields
#   MINIO__ACCESS_KEY -> minio.access_key
# Precedence (per-service loaders differ slightly; each config loader is
# authoritative):
#   YAML defaults < .env (godotenv) < real environment variables (compose
#   env_file injection)
# ============================================================

# ============================================================
# Shared secrets (used by multiple services)
# ============================================================

# User API key encryption master key (32-byte base64; shared by app-auth /
# app-bili to decrypt user_oauth SESSDATA). Do NOT put the key itself here;
# store it in a standalone key file (gitignored):
#   secrets/api_key_encryption_key   (content = one line of base64 key)
# Local direct start: set SECURITY__API_KEY_ENCRYPTION_KEY_FILE=secrets/api_key_encryption_key
# Containers: compose mounts the file at /run/secrets/ and injects *_FILE
# (FILE takes precedence over env; a direct env value is an emergency fallback)
# Generate: openssl rand -base64 32
# IMPORTANT: never rotate this key after deployment; already-stored user data
# becomes undecryptable.
# SECURITY__API_KEY_ENCRYPTION_KEY_FILE=secrets/api_key_encryption_key

# Full connection strings (credentials embedded); injected by compose into
# the app-go services and app-ts
# RDBMS__URL -> MySQL mind_base (app-auth/app-bili/app-note/app-quiz/app-cloud/app-settings/app-kg)
# MONGO__URI -> Mongo db mind_base (Go services) and mind_base_ts (app-ts own db)
# REDIS__URL -> rate limiting / captcha / quota / share cache / event bridge
# RDBMS__URL=mysql+aiomysql://mind_base:mind-base@mysql:3306/mind_base
# MONGO__URI=mongodb://user:pass@host:27017/mind_base
# REDIS__URL=redis://:password@host:6379/0

# MinIO credentials (app-cloud drive objects / app-ts skill zips and wallpapers / app-board)
# MINIO__ACCESS_KEY=
# MINIO__SECRET_KEY=

# app-kg HTTP cloud-doc routing endpoints token (shared by app-kg's
# APPKG__SERVER__INTERNAL_TOKEN and app-cloud's APPCLOUD__KG__TOKEN;
# empty = network-internal only)
# APP_KG_INTERNAL_TOKEN=

# app-cloud public-share device attestation HMAC secret (APPCLOUD__ATTEST__SECRET)
# IMPORTANT: must be identical on every replica in multi-replica deployments
# (challenges/tickets are stateless; nginx round-robins across replicas for
# signature verification).
# Format: 64-char hex (32 bytes) or any string >= 32 bytes; generate: openssl rand -hex 32
# Empty -> random key at startup (single replica only; a restart invalidates all tickets)
# APP_CLOUD_ATTEST_SECRET=

# Neo4j password (shared with the compose neo4j service via NEO4J_PASSWORD;
# app-kg reads KG__PASSWORD/NEO4J_PASSWORD)
# NEO4J_PASSWORD=mind-base

# ------------------------------------------------------------
# Higress AI gateway (--profile ai)
# ------------------------------------------------------------
# Role: the single egress for AI requests (LLM/embedding); APISIX fronts
# business traffic in, Higress fronts AI traffic out. Real vendor keys are
# configured in the console (host loopback http://127.0.0.1:18081) and
# persisted under ./data/higress -- never in .env/git.
# AI_GATEWAY__API_KEY is required; when missing, platform LLM calls fail at
# call time (it is the key-auth key of the Higress consumer mindbase-backend,
# see .gateway-consumer-key). BYOK (user-supplied credentials) connect
# directly, bypassing the gateway.
AI_GATEWAY__API_KEY=

# ------------------------------------------------------------
# OCR (app-ts doc parser; image documents)
# ------------------------------------------------------------
# Optional dedicated key for the OCR vision model; when unset it reuses
# AI_GATEWAY__API_KEY. Enablement (OCR__ENABLED) and model choice (OCR__MODEL)
# are non-sensitive and live in app-ts config default.yaml.
# OCR__API_KEY=

# ------------------------------------------------------------
# APISIX gateway
# ------------------------------------------------------------
# key-auth consumer key (service-to-service auth for /internal/*,
# /tasks/register, /internal/board/*)
# IMPORTANT: replace with a real secret in production.
# Keep this manually in sync with the key in apisix.yaml consumers
# (standalone mode does no env interpolation).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
APISIX_CONSUMER_KEY=generate-your-own-token_urlsafe-36
# Admin API key (apisix/config.yaml admin_key; Admin API :9180 / dashboard auth)
# IMPORTANT: change in production; standalone yaml does not support ${ENV}
# interpolation - write it into config.yaml directly or sed it at deploy time.
# APISIX_ADMIN_KEY=admin-key-change-me

# ------------------------------------------------------------
# app-board-mcp (MCP server; compose interpolation exempts it into .env)
# BOARD_MCP_UID     -> fixed uid for bearer clients (external MCP hosts);
#                      service mode (main app / app-ts) needs no such key.
#                      Find it in the MySQL users table, or in localStorage
#                      after logging into the frontend.
# BOARD_MCP_UID=
# BOARD_MCP_AUTH_TOKEN -> Bearer token (secret) for external MCP hosts to
#                      connect to http://127.0.0.1:8005/mcp
# BOARD_MCP_AUTH_TOKEN=
# Service mode needs no new secret: the main app (app-ts) reuses
# APISIX_CONSUMER_KEY as apikey plus a per-request X-Uid (the uid comes from
# the authenticated session and never enters LLM params) and connects to
# app-board-mcp:8005 over the internal network.
# BOARD_MCP_TLS_ENABLED -> TLS switch for the MCP http transport (default
#   false; set true for cross-host clients. The dev CA is generated at
#   mcp/app-board-mcp/certs/dev-ca.crt; point NODE_EXTRA_CA_CERTS at it on
#   the host side.)
# BOARD_MCP_TLS_ENABLED=false

# ------------------------------------------------------------
# app-note-mcp (MCP server; compose interpolation exempts it into .env)
# NOTE_MCP_UID     -> fixed uid for bearer clients (external MCP hosts);
#                     service mode (main app / app-ts) needs no such key
# NOTE_MCP_UID=
# NOTE_MCP_AUTH_TOKEN -> Bearer token (secret) for external MCP hosts to
#                     connect to http://127.0.0.1:8009/mcp
# NOTE_MCP_AUTH_TOKEN=

# QUIZ_MCP_UID     -> fixed uid for bearer clients (external MCP hosts);
#                     service mode needs no such key
# QUIZ_MCP_UID=
# QUIZ_MCP_AUTH_TOKEN -> Bearer token (secret) for external MCP hosts to
#                     connect to http://127.0.0.1:8012/mcp
# QUIZ_MCP_AUTH_TOKEN=
# Service mode needs no new secret: the main app (app-ts) reuses
# APISIX_CONSUMER_KEY as apikey plus a per-request X-Uid and connects to
# app-note-mcp:8009 over the internal network; app-note-mcp upstream calls to
# app-note reuse the same key.

# ============================================================
# Login / notification service credentials (fill the whole group together;
# non-sensitive switches live in the corresponding YAML sections)
# ============================================================

# WeChat QR login (wechat.enabled / app_id / redirect_uri go in the YAML
# wechat section)
# WECHAT__APP_SECRET=your_app_secret

# Alibaba Cloud SMS (sender = app-auth; see the sms section of
# app-go/app-auth/default.yaml: enabled / sign_name / template_code belong in
# that YAML; only the key pair goes here)
# The template must contain a ${code} parameter; signature and template must
# pass Alibaba Cloud review before sending.
# SMS__ACCESS_KEY_ID=LTAI5txxxxxxxxxxxx
# SMS__ACCESS_KEY_SECRET=your_access_key_secret

# ============================================================
# app-task - scheduled quiz task executor (standalone Go service) secrets
# ------------------------------------------------------------
# Prefix APPTASK__; reads the repo-root .env (godotenv); source and default
# config live in the standalone repo github.com/atoncooper/app-task
# ============================================================

# IMPORTANT: app-task uses its own MySQL (db app_task), not the main app db
# APPTASK__RDBMS__URL=mysql+aiomysql://app_task:app-task@127.0.0.1:3306/app_task
# app-task-mysql container credentials (docker-compose app-task-mysql service)
# APPTASK_MYSQL_ROOT_PASSWORD=root123
# APPTASK_MYSQL_USER=app_task
# APPTASK_MYSQL_PASSWORD=app-task

# Email (Resend) key
# IMPORTANT: without a key the email worker runs dry-run (no emails sent);
# required in production.
APPTASK_EMAIL_API_KEY=
# APPTASK__EMAIL__API_KEY=re_xxx   # alternative to the line above (this one wins when both are set)

# WebUI master API token (optional; scripts/APIs may call /api/* with admin
# equivalence)
# APPTASK__WEBUI__TOKEN=change-me

# ============================================================
# app-pay - commerce/membership service secrets (standalone Java Spring Boot)
# ------------------------------------------------------------
# IMPORTANT: the single config entrypoint is
# app-pay/src/main/resources/application*.yaml; this section lists only
# secret/password-class values (referenced via application*.yaml placeholders,
# never committed to git).
# ============================================================

# Dedicated MySQL (app-pay-mysql container; container and Java placeholders
# share the same variable names)
# IMPORTANT: the values below are local-dev defaults (app-pay-mysql is exposed
# on loopback 127.0.0.1:3307 only); use strong passwords for public/remote deploys.
PAY_MYSQL_ROOT_PASSWORD=root123
PAY_MYSQL_USER=app_pay
PAY_MYSQL_PASSWORD=app-pay

# Alipay face-to-face payment credential group (APP_ID ships together with
# the three keys; gateway/notify URLs live in application.yaml)
# Both keys start with MII and are easy to confuse - naming follows "who
# generated it":
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY=          # application private key (generated by you with the key tool; signs requests)
# ALIPAY_APP_PUBLIC_KEY=           # application public key (same pair as the private key; only uploaded to the open platform, not consumed at runtime)
# ALIPAY_PLATFORM_PUBLIC_KEY=      # Alipay platform public key (from the console "interface signing" page; verifies responses/callbacks - NOT your application public key)

# Test entry token (application-test.yaml placeholder; default local-test-token)
# PAY_TEST_TOKEN=local-test-token

# Timeout-delegation executor endpoint token (optional; when non-empty,
# /internal/pay/timeout/execute enforces it; the token is delivered via the
# registered executor_url query string, no app-task changes needed)
PAY_EXECUTOR_TOKEN=generate-your-own-token_urlsafe-24

# app-pay-admin console master API token (optional; scripts may call /api/*
# with admin equivalence)
# PAYADMIN__WEBUI__TOKEN=

# ============================================================
# SDK-read variables (exception: these SDKs read env vars only, never YAML)
# ============================================================

# LangSmith - read directly by app-ts LLM tracing (src/llm/tracing.ts);
# all three must be set to enable tracing
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=MindBase
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# docker-compose interpolation variables (exception: compose has no YAML
# mechanism, env only)
# ============================================================

# app-pay
# PAY_MYSQL_PORT=3307            # host-mapped port (local IDE/client debugging only)
# APP_PAY_PORT=8002
# APP_PAY_TEST_PORT=18002
# app-pay-admin
# APP_PAY_ADMIN_PORT=8003
# app-admin（分享审核后台）
# APP_ADMIN_PORT=8016
# APP_ADMIN_WEB_PORT=3001
# APPADMIN__SECURITY__IP_ALLOWLIST=192.0.2.10/32,10.20.0.0/16
# 分享内容审核预览（app-admin ↔ app-cloud 内部共享令牌，两边同值）
# 生成：openssl rand -hex 32；留空 = 管理台无法预览分享内容（fail closed）
# APP_CLOUD_ADMIN_REVIEW_TOKEN=

# ============================================================
# app-board - mindmap/whiteboard content storage (standalone Go service) secrets
# ------------------------------------------------------------
# Prefix APPBOARD__; reads the repo-root .env (godotenv); non-sensitive
# config lives in the service's embedded default.yaml
# ============================================================

# Shares the main app MySQL (db mind_base) and MongoDB; board tables are
# created by the service at startup
# APPBOARD__RDBMS__URL=mysql+aiomysql://mind_base:mind-base@127.0.0.1:3306/mind_base
# APPBOARD__MONGO__URI=mongodb://admin:mind-base@127.0.0.1:27017/?authSource=admin
# Read-cache connection (credentials embedded; TTL etc. in service config)
# APPBOARD__REDIS__URL=redis://:mind-base@127.0.0.1:6379/2

# ------------------------------------------------------------
# Public share domain (non-sensitive; compose interpolates it into the
# frontend runtime + cert-gen SAN)
# ------------------------------------------------------------
# When set, all share links (notes /notes/shared/, drive /cloud/s/) are built
# with this domain instead of the creator's current localhost. For local
# testing point the domain at 127.0.0.1 in your hosts file.
# Bare domain only (no http:// prefix); an explicit https:// prefix is also
# accepted.
# Empty -> auto-detect the deploy host's public IP (SHARE_PUBLIC_IP overrides
# manually); detection failure -> fall back to the creator's current address
# (local-test semantics).
# SHARE_DOMAIN=
# SHARE_PUBLIC_IP=

# ------------------------------------------------------------
# Web search sources (web_search tool engine chain; optional - without them
# only the Baidu/Bing scraper fallback remains, quality unreliable)
# ------------------------------------------------------------
# Tavily (recommended): get a key at https://tavily.com, free 1000 calls/month
# TAVILY_API_KEY=tvly-xxxx
# Self-hosted SearXNG (enable json format in its settings.yml)
# SEARXNG_URL=http://searxng:8080

# ------------------------------------------------------------
# Skill store (GitHub repo browse/install; required for private skill repos)
# ------------------------------------------------------------
# GitHub personal access token (PAT): Settings -> Developer settings ->
# Personal access tokens
# Least privilege: fine-grained -> select only the skill repo ->
# Repository permissions -> Contents: Read-only
# Public skill repos need no token; with one the API limit rises from
# 60/hour to 5000/hour.
# SKILL_STORE_API_KEY=github_pat_xxx or ghp_xxx
# (deploy/swarm also forwards the legacy spelling SKILL_STORE__API_KEY)

# app-pay P1 key separation (manually synced with apisix.yaml consumers):
#   PAY_OPS_KEY      - dedicated to fund-write operations (/internal/pay/grant,
#                      order refunds); never injected into business containers
#   PAY_READONLY_KEY - membership query read-only (/internal/pay/membership/*)
# Generate the same way as APISIX_CONSUMER_KEY (token_urlsafe(36))
# PAY_READONLY_KEY=
# PAY_OPS_KEY=

# pay-admin refund review workbench (P0): calls app-pay internal endpoints via
# the APISIX pay-ops consumer.
# ops_key = value of PAY_OPS_KEY (copy it over; empty = review feature hidden
# in the console).
# PAYADMIN__APP_PAY__OPS_KEY=
# PAYADMIN__APP_PAY__BASE_URL=http://apisix:9080

# ============================================================
# app-admin - share-moderation admin console (standalone Go service)
# ------------------------------------------------------------
# Prefix APPADMIN__; reads the repo-root .env (godotenv); non-sensitive
# config lives in the service's embedded default.yaml (app-go/app-admin).
# Direct-connects the shared bilirag MySQL (same RDBMS__URL as the other
# app-go services - no extra connection string needed); the only write onto
# shared tables is the four moderation columns of cloud_shares.
# ============================================================

# Seeded console admin account (insert-once on first boot; only the missing
# username is inserted, never overwritten). First login forces a password
# change (must_change_password=1, POST /api/me/password). Production MUST
# override the default password below.
# APPADMIN__SEED__USERNAME=admin
# APPADMIN__SEED__PASSWORD=app-admin

# RDBMS__URL: reused as-is (see "Shared secrets" near the top of this file);
# docker-compose maps it into APPADMIN__RDBMS__URL automatically.
