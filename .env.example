# ============================================================
# MindBase —— 环境变量（.env）
# ------------------------------------------------------------
# ⚠️ 规矩（必须遵守）：本文件只允许出现【密钥 / 敏感信息】：
#   - API key / secret / token / password / 私钥
#   - 含密码的连接串（RDBMS__URL / MONGO__URI / REDIS__URL）
# 仅有的两类例外（见下方各自小节）：
#   - SDK 直读变量（LangSmith 等 SDK 只认环境变量，不读 YAML）
#   - docker-compose 插值变量（端口 / 镜像 tag —— compose 没有 YAML 机制）
# 所有普通配置（开关 / 模型名 / 超时 / 并发 / URL / 路径 / CORS 等）
# 一律改各服务自己的 YAML，不要往这里塞：
#   - app-ts   → app-ts/src/config/（default.yaml）
#   - app-go 各服务 → app-go/<svc>/internal/config/default.yaml（embed）
#   - app-pay  → app-pay/src/main/resources/application*.yaml
# 各服务 YAML 中的敏感字段以 ${VAR} 占位符引用本文件的变量。
#
# 命名规则:env 变量用 `双下划线` 嵌套到 YAML 字段
#   MINIO__ACCESS_KEY → minio.access_key
# 优先级（各服务实现略有差异，以各自 config loader 为准）：
#   YAML 默认值 < .env（godotenv） < 真实环境变量（compose env_file 注入）
# ============================================================

# ============================================================
# 共享密钥（多服务共用）
# ============================================================

# 用户 API Key 加密主密钥（32 字节 base64;app-auth/app-bili 解密 user_oauth
# 的 SESSDATA 共用）——⚠️ 不放本文件,独立密钥文件存放（gitignored）:
#   secrets/api_key_encryption_key   （内容 = 一行 base64 key）
# 本地直启: .env 设 SECURITY__API_KEY_ENCRYPTION_KEY_FILE=secrets/api_key_encryption_key
# 容器: compose 挂载该文件到 /run/secrets/ 并注入 *_FILE（优先级 FILE > env;
# 直读 env 仅作应急回退）
# 生成: openssl rand -base64 32
# ⚠️ 部署后不要更换此密钥,否则所有已存储的用户数据将无法解密
# SECURITY__API_KEY_ENCRYPTION_KEY_FILE=secrets/api_key_encryption_key

# 完整连接串(含密码);由 compose 注入给 app-go 各服务与 app-ts
# RDBMS__URL  → MySQL mind_base（app-auth/app-bili/app-note/app-quiz/app-cloud/app-settings/app-kg）
# MONGO__URI  → Mongo 库 mind_base（Go 服务）与 mind_base_ts（app-ts 自有库）
# REDIS__URL  → 限流/验证码/quota/分享缓存/事件桥
# RDBMS__URL=mysql+aiomysql://mind_base:mind-base@mysql:3306/mind_base
# MONGO__URI=mongodb://user:pass@host:27017/mind_base
# REDIS__URL=redis://:password@host:6379/0

# MinIO 凭证（app-cloud 云盘对象 / app-ts 技能 zip 与壁纸 / app-board）
# MINIO__ACCESS_KEY=
# MINIO__SECRET_KEY=

# Neo4j 密码（与 compose 的 neo4j 服务共享 NEO4J_PASSWORD；app-kg 读 KG__PASSWORD/NEO4J_PASSWORD）
# NEO4J_PASSWORD=mind-base

# Skill store 的 GitHub token（可选；app-ts skills store 客户端，降低限流）
# SKILL_STORE__API_KEY=

# ------------------------------------------------------------
# Higress AI gateway (--profile ai)
# ------------------------------------------------------------
# Role: the single egress for AI requests (LLM/embedding); APISIX fronts
# business traffic in, Higress fronts AI traffic out. Real vendor keys are
# configured in the console (host loopback http://127.0.0.1:18081) and
# persisted under ./data/higress — never in .env/git.
# AI_GATEWAY__API_KEY is required; when missing, platform LLM calls fail at
# OCR__API_KEY=            # 可选：OCR 视觉模型独立 key（默认复用 AI_GATEWAY__API_KEY）
# call time (it is the key-auth key of the Higress consumer mindbase-backend,
# see .gateway-consumer-key). BYOK (user-supplied credentials) connect
# directly, bypassing the gateway.
AI_GATEWAY__API_KEY=

# ------------------------------------------------------------
# APISIX 网关
# ------------------------------------------------------------
# key-auth consumer key(服务间调用 /internal/* /tasks/register /internal/board/* 鉴权)
# ⚠️ 生产必改为真实 secret
APISIX_CONSUMER_KEY=mindbase-internal-key-change-me
# Admin API key(apisix/config.yaml admin_key;Admin API :9180 / dashboard 鉴权)
# ⚠️ 生产必改;standalone yaml 不支持 ${ENV} 插值,需在 config.yaml 直接写或部署时 sed 替换
# APISIX_ADMIN_KEY=admin-key-change-me

# ------------------------------------------------------------
# app-board-mcp(MCP server,compose 插值豁免进 .env)
# BOARD_MCP_UID    → bearer 客户端(外部 MCP 宿主)的固定 uid;服务模式(主 app(app-ts))无需此键;
#                    在 MySQL users 表查看,或登录前端后取 localStorage 的 uid
# BOARD_MCP_UID=
# BOARD_MCP_AUTH_TOKEN → 外部 MCP 宿主连 http://127.0.0.1:8005/mcp 的 Bearer token(密钥)
# BOARD_MCP_AUTH_TOKEN=
# 服务模式无需新密钥:主 app(app-ts) 复用 APISIX_CONSUMER_KEY 作 apikey + 每请求 X-Uid
#   (uid 来自已认证会话,永不经过 LLM 参数),经内网直连 app-board-mcp:8005
# BOARD_MCP_TLS_ENABLED → MCP http 传输 TLS 开关(默认 false;跨机宿主时置 true,
#   dev-CA 生成在 mcp/app-board-mcp/certs/dev-ca.crt,宿主侧 NODE_EXTRA_CA_CERTS 指向它)
# BOARD_MCP_TLS_ENABLED=false

# ------------------------------------------------------------
# app-note-mcp(MCP server,compose 插值豁免进 .env)
# NOTE_MCP_UID    → bearer 客户端(外部 MCP 宿主)的固定 uid;服务模式(主 app(app-ts))无需此键
# NOTE_MCP_UID=
# NOTE_MCP_AUTH_TOKEN → 外部 MCP 宿主连 http://127.0.0.1:8009/mcp 的 Bearer token(密钥)
# NOTE_MCP_AUTH_TOKEN=

# QUIZ_MCP_UID    → bearer 客户端(外部 MCP 宿主)的固定 uid；服务模式无需此键
# QUIZ_MCP_UID=
# QUIZ_MCP_AUTH_TOKEN → 外部 MCP 宿主连 http://127.0.0.1:8012/mcp 的 Bearer token(密钥)
# QUIZ_MCP_AUTH_TOKEN=
# 服务模式无需新密钥:主 app(app-ts) 复用 APISIX_CONSUMER_KEY 作 apikey + 每请求 X-Uid,
#   经内网直连 app-note-mcp:8009;app-note-mcp 上游调 app-note 也复用同一 key

# ============================================================
# 登录/通知服务凭证(整组一起填;开关等非敏感字段在 YAML 对应段直接填)
# ============================================================

# 微信扫码登录(wechat.enabled/app_id/redirect_uri 在 YAML wechat 段填)
# WECHAT__APP_SECRET=your_app_secret

# 阿里云短信(发码方=app-auth,见 app-go/app-auth/default.yaml sms 段:
# enabled/sign_name/template_code 在该 YAML 填;此处只放密钥对)
# 模板须含 ${code} 参数;签名/模板需阿里云审核通过后才能发送
# SMS__ACCESS_KEY_ID=LTAI5txxxxxxxxxxxx
# SMS__ACCESS_KEY_SECRET=your_access_key_secret

# ============================================================
# app-task —— 定时出题任务执行器(Go 独立服务)密钥
# ------------------------------------------------------------
# 前缀 APPTASK__;读项目根 .env(godotenv);源码与默认配置在独立仓库 github.com/atoncooper/app-task
# ============================================================

# ⚠️ app-task 使用独立 MySQL(库 app_task),不共享主 app 的库
# APPTASK__RDBMS__URL=mysql+aiomysql://app_task:app-task@127.0.0.1:3306/app_task
# app-task-mysql 容器口令(docker-compose app-task-mysql 服务)
# APPTASK_MYSQL_ROOT_PASSWORD=root123
# APPTASK_MYSQL_USER=app_task
# APPTASK_MYSQL_PASSWORD=app-task

# 邮件(Resend)key
# ⚠️ 未配置时邮件 worker 走 dry-run(不发邮件);生产必配
APPTASK_EMAIL_API_KEY=
# APPTASK__EMAIL__API_KEY=re_xxx   # 与上行二选一(后者优先)

# WebUI master API token(可选;脚本/API 直接调 /api/*,等价 admin)
# APPTASK__WEBUI__TOKEN=change-me

# ============================================================
# app-pay —— 交易/会员服务密钥(Java Spring Boot 独立服务)
# ------------------------------------------------------------
# ⚠️ 配置唯一入口 = app-pay/src/main/resources/application*.yaml;
#    本段只列"密钥/口令"类敏感值(经 application*.yaml 占位符引用,不进 git)
# ============================================================

# 独立 MySQL(app-pay-mysql 容器;容器与 Java 占位符共用以下同名变量)
PAY_MYSQL_ROOT_PASSWORD=root123
PAY_MYSQL_USER=app_pay
PAY_MYSQL_PASSWORD=app-pay

# 支付宝当面付凭证组(APP_ID 与三把钥匙配套填写;网关/通知 URL 等在 application.yaml)
# 两把钥匙都以 MII 开头,极易混淆——命名按"谁生成"区分:
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY=          # 应用私钥(你用密钥工具生成,签名请求)
# ALIPAY_APP_PUBLIC_KEY=           # 应用公钥(与应用私钥同对;仅上传开放平台用,本服务运行时不消费)
# ALIPAY_PLATFORM_PUBLIC_KEY=      # 支付宝公钥(平台控制台"接口加签方式"提供,验签响应/回调——不是你生成的应用公钥)

# 测试入口令牌(application-test.yaml 占位符;默认 local-test-token)
# PAY_TEST_TOKEN=local-test-token

# 超时委托 executor 端点令牌(可选;非空则 /internal/pay/timeout/execute 强制校验,
# 令牌经注册的 executor_url 查询串下发,app-task 无需改造)
# PAY_EXECUTOR_TOKEN=

# app-pay-admin 控制台 master API token(可选;设置后脚本可凭它以 admin 身份调 /api/*)
# PAYADMIN__WEBUI__TOKEN=

# ============================================================
# SDK 直读变量(例外:这些 SDK 只认环境变量,不读 YAML)
# ============================================================

# LangSmith —— app-ts LLM tracing（src/llm/tracing.ts）直读;启用 trace 必须三件套同时设置
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=MindBase
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# docker-compose 插值变量(例外:compose 无 YAML 机制,只能走 env)
# ============================================================

# app-pay
# PAY_MYSQL_PORT=3307            # 宿主映射端口(仅本机 IDE/客户端调试用)
# APP_PAY_PORT=8002
# APP_PAY_TEST_PORT=18002
# app-pay-admin
# APP_PAY_ADMIN_PORT=8003

# ============================================================
# app-board -- 思维导图/白板内容存储(Go 独立服务)密钥
# ------------------------------------------------------------
# 前缀 APPBOARD__;读项目根 .env(godotenv);非敏感配置在 app-board 内嵌 default.yaml
# ============================================================

# 共享主 app 的 MySQL(库 mind_base)与 MongoDB;board 表由服务启动自建
# APPBOARD__RDBMS__URL=mysql+aiomysql://mind_base:mind-base@127.0.0.1:3306/mind_base
# APPBOARD__MONGO__URI=mongodb://admin:mind-base@127.0.0.1:27017/?authSource=admin
# 读缓存连接(含密码;TTL 等在服务配置)
# APPBOARD__REDIS__URL=redis://:mind-base@127.0.0.1:6379/2

# ── 对外分享域名(非敏感;compose 插值注入 frontend 运行时 + cert-gen SAN)──
# 配置后所有分享链接(笔记 /notes/shared/、云盘 /cloud/s/)用该域名生成,
# 而不是创建者当前访问的 localhost。本地测试需在 hosts 把域名指向 127.0.0.1。
# 只写裸域名(不带 http:// 前缀),也支持显式 https:// 前缀。
# 留空 → 自动探测部署机公网 IP(SHARE_PUBLIC_IP 可手工覆盖);
# 探测失败 → 回退创建者当前访问地址(本地测试语义)。
# SHARE_DOMAIN=
# SHARE_PUBLIC_IP=

# ── 联网搜索源（web_search 工具引擎链，可选：不配置则只剩百度/Bing 爬虫兜底，质量不可靠）──
# Tavily（推荐）：注册 https://tavily.com 取 key，免费 1000 次/月
# TAVILY_API_KEY=tvly-xxxx
# 自托管 SearXNG（需在其 settings.yml 开启 json format）
# SEARXNG_URL=http://searxng:8080

# ── 技能商店（GitHub 仓库浏览/安装；私有技能仓库必填）──
# GitHub 个人访问令牌（PAT）：Settings → Developer settings → Personal access tokens
# 权限最小化：Fine-grained → 仅勾选技能仓库 → Repository permissions → Contents: Read-only
# 公开技能仓库无需配置；配置后 API 限额从 60 次/时提升到 5000 次/时
# SKILL_STORE_API_KEY=github_pat_xxx 或 ghp_xxx
