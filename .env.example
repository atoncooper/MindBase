# ============================================================
# MindBase —— 环境变量（.env）
# ------------------------------------------------------------
# ⚠️ 规矩（必须遵守）：本文件只允许出现【密钥 / 敏感信息】：
#   - API key / secret / token / password / 私钥
#   - 含密码的连接串（RDBMS__URL / MONGO__URI / REDIS__URL / MQ__RABBITMQ_URL）
# 仅有的两类例外（见下方各自小节）：
#   - SDK 直读变量（LangSmith 等 SDK 只认环境变量，不读我们的 YAML）
#   - docker-compose 插值变量（端口 / 镜像 tag —— compose 没有 YAML 机制）
# 所有普通配置（开关 / 模型名 / 超时 / 并发 / URL / 路径 / CORS 等）
# 一律改 app/config/*.yaml，不要往这里塞。
# YAML 中的敏感字段以 ${VAR} 占位符引用本文件的变量（loader 加载时从环境展开）。
#
# 配置层级(由低到高,后者覆盖前者):
#   1. 代码默认值(settings._get 的 default)
#   2. app/config/default.yaml
#   3. app/config/config.yaml             ← team-shared overrides (committed, optional)
#   4. app/config/local.yaml              ← personal overrides (.gitignore)
#   5. 环境变量(本文件)                   ← highest priority; 仅密钥/敏感信息
#
# 命名规则:env 变量用 `双下划线` 嵌套到 YAML 字段
#   MINIO__ACCESS_KEY → minio.access_key
# ============================================================

# ============================================================
# 主应用密钥
# ============================================================

# 遗留兼容 key:全部 AI 流量(LLM/embedding/rerank/ASR)统一走网关,本 key 已不参与
# 任何连接;仅离线评测脚本的 key 回落链(JUDGE__API_KEY→OPENAI_API_KEY→LLM__API_KEY)仍引用。
# BYOK 凭证必须自带端点,无端点直接报错(遗留直连地址已删除)
LLM__API_KEY=

# FastAPI session 签名密钥
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION__SECRET=

# 用户 API Key 加密密钥(32 字节,base64 编码)
# 生成: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# ⚠️ 部署后不要修改此密钥,否则所有已存储的用户 API Key 将无法解密
SECURITY__API_KEY_ENCRYPTION_KEY=

# 完整连接串(含密码);host/port/db 等非敏感部分在 YAML 对应段
# MONGO__URI=mongodb://user:pass@host:27017/mind_base
# REDIS__URL=redis://:password@host:6379/0
# REDIS__PASSWORD=
# MQ__RABBITMQ_URL=amqp://user:pass@host:5672/
# RDBMS__URL=postgresql+asyncpg://user:pass@host:5432/mind_base   # 生产;开发期 sqlite 走 YAML

# MinIO 凭证
# MINIO__ACCESS_KEY=
# MINIO__SECRET_KEY=

# Neo4j 密码(与 compose 的 neo4j 服务共享 NEO4J_PASSWORD;URI 等在 YAML kg 段)
# NEO4J_PASSWORD=mind-base

# Rerank 连接已统一走 AI 网关(consumer key),无独立密钥

# Daytona 代码沙箱 key(开关/org_id/禁网白名单等在 YAML daytona 段)
# DAYTONA__API_KEY=

# Skill store 的 GitHub token(可选;开关/topic 在 YAML skill_store 段)
# SKILL_STORE__API_KEY=

# ------------------------------------------------------------
# Higress AI gateway (--profile ai)
# ------------------------------------------------------------
# Role: the single egress for AI requests (LLM/embedding); APISIX fronts
# business traffic in, Higress fronts AI traffic out. Real vendor keys are
# configured in the console (host loopback http://127.0.0.1:18081) and
# persisted under ./data/higress — never in .env/git.
# AI_GATEWAY__API_KEY is required; when missing, platform LLM calls fail at
# call time (it is the key-auth key of the Higress consumer mindbase-backend,
# see .gateway-consumer-key). BYOK (user-supplied credentials) connect
# directly, bypassing the gateway.
AI_GATEWAY__API_KEY=

# ------------------------------------------------------------
# APISIX 网关
# ------------------------------------------------------------
# key-auth consumer key(服务间调用 /internal/* /tasks/register 鉴权)
# ⚠️ 生产必改为真实 secret
APISIX_CONSUMER_KEY=mindbase-internal-key-change-me
# Admin API key(apisix/config.yaml admin_key;Admin API :9180 / dashboard 鉴权)
# ⚠️ 生产必改;standalone yaml 不支持 ${ENV} 插值,需在 config.yaml 直接写或部署时 sed 替换
# APISIX_ADMIN_KEY=admin-key-change-me

# ============================================================
# 登录/通知服务凭证(整组一起填;开关等非敏感字段在 YAML 对应段直接填)
# ============================================================

# 微信扫码登录(wechat.enabled/app_id/redirect_uri 在 YAML wechat 段填)
# WECHAT__APP_SECRET=your_app_secret

# 阿里云短信(凭证对一起填;sms.enabled/sign_name/template_code 在 YAML sms 段填)
# SMS__ACCESS_KEY_ID=LTAI5txxxxxxxxxxxx
# SMS__ACCESS_KEY_SECRET=your_access_key_secret

# ============================================================
# app-task —— 定时出题任务执行器(Go 独立服务)密钥
# ------------------------------------------------------------
# 前缀 APPTASK__;读项目根 .env(godotenv);非敏感配置在 app-task/default.yaml
# ============================================================

# ⚠️ app-task 使用独立 MySQL(库 app_task),不共享主 app 的库
# APPTASK__RDBMS__URL=mysql+aiomysql://app_task:app-task@127.0.0.1:3306/app_task
# app-task-mysql 容器口令(docker-compose app-task-mysql 服务)
# APPTASK_MYSQL_ROOT_PASSWORD=root123
# APPTASK_MYSQL_USER=app_task
# APPTASK_MYSQL_PASSWORD=app-task

# 邮件(Resend)key
# ⚠️ 未配置时邮件 worker 走 dry-run(不发邮件);生产必配
APPTASK_EMAIL_API_KEY=
# APPTASK__EMAIL__API_KEY=re_xxx   # 与上行二选一(后者优先)

# WebUI master API token(可选;脚本/API 直接调 /api/*,等价 admin)
# APPTASK__WEBUI__TOKEN=change-me

# ============================================================
# app-pay —— 交易/会员服务密钥(Java Spring Boot 独立服务)
# ------------------------------------------------------------
# ⚠️ 配置唯一入口 = app-pay/src/main/resources/application*.yaml;
#    本段只列"密钥/口令"类敏感值(经 application*.yaml 占位符引用,不进 git)
# ============================================================

# 独立 MySQL(app-pay-mysql 容器;容器与 Java 占位符共用以下同名变量)
PAY_MYSQL_ROOT_PASSWORD=root123
PAY_MYSQL_USER=app_pay
PAY_MYSQL_PASSWORD=app-pay

# 支付宝当面付凭证组(APP_ID 与三把钥匙配套填写;网关/通知 URL 等在 application.yaml)
# 两把钥匙都以 MII 开头,极易混淆——命名按"谁生成"区分:
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY=          # 应用私钥(你用密钥工具生成,签名请求)
# ALIPAY_APP_PUBLIC_KEY=           # 应用公钥(与应用私钥同对;仅上传开放平台用,本服务运行时不消费)
# ALIPAY_PLATFORM_PUBLIC_KEY=      # 支付宝公钥(平台控制台"接口加签方式"提供,验签响应/回调——不是你生成的应用公钥)

# 测试入口令牌(application-test.yaml 占位符;默认 local-test-token)
# PAY_TEST_TOKEN=local-test-token

# app-pay-admin 控制台 master API token(可选;设置后脚本可凭它以 admin 身份调 /api/*)
# PAYADMIN__WEBUI__TOKEN=

# ============================================================
# SDK 直读变量(例外:这些 SDK/脚本只认环境变量,不读我们的 YAML)
# ============================================================

# LangSmith —— LangChain SDK 直读;启用 trace 必须三件套同时设置
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=MindBase
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Eval Judge —— 离线评测打分 LLM(仅 python -m app.test.eval.runner 使用)。
# 默认经 AI 网关(与全部 AI 流量同路径,无需配置),模型名默认回落 llm.eval_model。
# 跨供应商直连逃生口:JUDGE__BASE_URL 与 JUDGE__API_KEY 必须成对设置(只设其一会报错);
# 注意评审员应与被测主模型异源,避免同源偏倚
# JUDGE__API_KEY=
# JUDGE__BASE_URL=
# JUDGE__MODEL=

# ============================================================
# docker-compose 插值变量(例外:compose 无 YAML 机制,只能走 env)
# ============================================================

# app-task
# APPTASK_BASE_URL=http://apisix:9080   # 遗留:主 app 代码 os.environ 直读,待重构归 YAML
# app-pay
# PAY_MYSQL_PORT=3307            # 宿主映射端口(仅本机 IDE/客户端调试用)
# APP_PAY_PORT=8002
# APP_PAY_TEST_PORT=18002
# APP_PAY_IMAGE=ghcr.io/atoncooper/mind-base-app-pay:latest
# app-pay-admin
# APP_PAY_ADMIN_PORT=8003
# APP_PAY_ADMIN_IMAGE=ghcr.io/atoncooper/mind-base-app-pay-admin:latest
# higress
# HIGRESS_GATEWAY_HTTP_PORT=18080    # 网关 OpenAI 兼容口(仅回环;容器内固定 8080)
# HIGRESS_GATEWAY_HTTPS_PORT=18443
# HIGRESS_CONSOLE_PORT=18081         # 管理控制台(仅回环)
# HIGRESS_IMAGE=                     # 需钉死 digest 时设 repo@sha256:<digest>(默认 all-in-one:latest)
# 自建镜像 tag(默认 :latest;建议版本化 tag,或用 scripts/docker-build.ps1 自动清悬空镜像)
# BACKEND_IMAGE=ghcr.io/atoncooper/mind-base-backend:latest
# FRONTEND_IMAGE=ghcr.io/atoncooper/mind-base-frontend:latest
# APPTASK_IMAGE=ghcr.io/atoncooper/mind-base-app-task:latest

# ============================================================
# app-board -- 思维导图/白板内容存储(Go 独立服务)密钥
# ------------------------------------------------------------
# 前缀 APPBOARD__;读项目根 .env(godotenv);非敏感配置在 app-board 内嵌 default.yaml
# ============================================================

# 共享主 app 的 MySQL(库 mind_base)与 MongoDB;board 表由服务启动自建
# APPBOARD__RDBMS__URL=mysql+aiomysql://mind_base:mind-base@127.0.0.1:3306/mind_base
# APPBOARD__MONGO__URI=mongodb://admin:mind-base@127.0.0.1:27017/?authSource=admin
# 读缓存连接(含密码;TTL 等在服务配置)
# APPBOARD__REDIS__URL=redis://:mind-base@127.0.0.1:6379/2

# ============================================================
# 已废弃 —— 普通配置项早已迁入 app/config/*.yaml(勿再走 env)
# ------------------------------------------------------------
# DASHSCOPE_API_KEY      → LLM__API_KEY(本文件)
# OPENAI_API_KEY         → LLM__API_KEY(本文件)
# OPENAI_BASE_URL        → llm.base_url(default.yaml)
# LLM_MODEL              → llm.model(default.yaml)
# EMBEDDING_MODEL        → embedding.model(default.yaml)
# EVAL_LLM_MODEL         → llm.eval_model(default.yaml)
# DASHSCOPE_BASE_URL     → asr.base_url(default.yaml)
# ASR_MODEL              → asr.model(default.yaml)
# ASR_TIMEOUT            → asr.timeout(default.yaml)
# ASR_MODEL_LOCAL        → asr.model_local(default.yaml)
# ASR_INPUT_FORMAT       → asr.input_format(default.yaml)
# APP_HOST               → server.host(default.yaml)
# APP_PORT               → server.port(default.yaml)
# DEBUG                  → app.debug(config.yaml)
# DATABASE_URL           → rdbms.url(default.yaml,生产走 RDBMS__URL env)
# CHUNK_TARGET_SIZE      → chunk.target_size(default.yaml)
# CHUNK_MIN_SIZE         → chunk.min_size(default.yaml)
# CHUNK_MAX_SIZE         → chunk.max_size(default.yaml)
# CHUNK_OVERLAP          → chunk.overlap(default.yaml)
# EMBEDDING_VERSION      → embedding.version(default.yaml)
# API_KEY_ENCRYPTION_KEY → SECURITY__API_KEY_ENCRYPTION_KEY(本文件)
# SECURITY__CORS__ALLOW_ORIGINS → security.cors.allow_origins(default.yaml)
# SECURITY__CAPTCHA__ENABLED    → security.captcha.enabled(default.yaml)
# RERANK__ENABLED               → rerank.enabled(default.yaml)
# KG__URI                       → kg.uri(default.yaml;compose 已注入)
# ============================================================
