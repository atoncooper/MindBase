        request_headers: [Authorization]
        upstream_headers: [X-Uid, X-Roles]
        timeout: 5000
        status_code: 401

  # /notes/* -> app-content（note 面；笔记服务；切流自主 backend catch_all。宽验证
  # forward-auth 与 catch_all 语义一致：无凭证放行，公开分享页
  # /notes/shared/{token} 免登录可达，受保护端点对缺失 X-Uid 自行 401。
  # 回滚方式：删除本路由（该 URI 将 404——Python 面已退役，无回落）。
  - id: notes_user
    uris: [/notes, /notes/*]
    priority: 50
    labels:
      domain: user
    upstream_id: upstream-app-content-note
    plugins:
      request-id:
        include_in_response: true
        header_name: X-Request-Id
      proxy-rewrite:
        headers:
          remove: [X-Uid, X-Roles]
      forward-auth:
        uri: "https://app-user:8006/internal/auth/verify"
        request_headers: [Authorization]
        upstream_headers: [X-Uid, X-Roles]
        timeout: 5000
        status_code: 401

# ============================================================
# Internal TLS termination (9443 listener, rendered by render-config.sh)
# ============================================================
# BEGIN-INTERNAL-TLS
ssls:
  - id: internal-9443
    labels:
      purpose: internal-service-tls
    cert: |
__APISIX_TLS_CERT_PEM__
    key: |
__APISIX_TLS_KEY_PEM__
    snis: [apisix, mindbase, localhost]
# END-INTERNAL-TLS

# ============================================================
# Consumers
# ============================================================
consumers:
  # Service-to-service M2M consumer. limit-count is a per-consumer quota so a
  # misfiring caller degrades to 429 instead of saturating the backend.
  - username: internal
    plugins:
      key-auth:
        key: __APISIX_CONSUMER_KEY__  # rendered from env APISIX_CONSUMER_KEY
      limit-count:
        count: 12000
        time_window: 60
        rejected_code: 429
        key_type: var
        key: consumer_name
  - username: pay_readonly
    # P1 密钥分权：会员查询只读密钥（/internal/pay/membership/*）
    plugins:
      key-auth:
        key: __PAY_READONLY_KEY__
      limit-count:
        count: 3000
        time_window: 60
        rejected_code: 429
        key_type: var
        key: consumer_name
  - username: pay_ops
    # P1 密钥分权：资金写操作专用密钥（grant / orders 退款），只存 .env PAY_OPS_KEY，不下发业务容器
    plugins:
      key-auth:
        key: __PAY_OPS_KEY__
      limit-count:
        count: 600
        time_window: 60
        rejected_code: 429
        key_type: var
        key: consumer_name

#END