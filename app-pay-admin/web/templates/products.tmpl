{{define "content"}}
<div class="panel">
  <table class="tbl">
    <thead><tr><th>code</th><th>名称</th><th>时长</th><th class="num">价格</th><th>状态</th><th>排序</th><th>更新时间</th></tr></thead>
    <tbody>
    {{range .Items}}
      <tr>
        <td class="mono strong">{{.Code}}</td>
        <td>{{.Title}}</td>
        <td>{{.DurationDays}} 天</td>
        <td class="num mono">{{.Price}}</td>
        <td><span class="st {{if .Active}}st-green{{else}}st-gray{{end}}"><i></i>{{if .Active}}在售{{else}}下架{{end}}</span></td>
        <td>{{.Sort}}</td>
        <td>{{.UpdatedAt}}</td>
      </tr>
    {{else}}
      <tr><td colspan="7" class="empty">暂无 SKU（app-pay 启动时自动播种）</td></tr>
    {{end}}
    </tbody>
  </table>
  <div class="panel-note">价格调整请走 app-pay 运营改库流程（种子价格不覆盖运营侧修改）。</div>
</div>
{{end}}
