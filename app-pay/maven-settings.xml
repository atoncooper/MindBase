<?xml version="1.0" encoding="UTF-8"?>
<!-- Used only during Docker builds (mounted at /root/.m2/settings.xml): central goes through the Alibaba Cloud mirror to avoid download timeouts in China.
     Host mvn development does not use this file; it uses your local ~/.m2/settings.xml. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <mirrors>
        <mirror>
            <id>aliyun-public</id>
            <mirrorOf>central</mirrorOf>
            <name>Aliyun Maven Public</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </mirror>
    </mirrors>
</settings>
