<?xml version="1.0" encoding="UTF-8"?>
<!-- Payment system logging: runtime logs (console+file) and fund audit (separate JSONL file) are split.
     The audit file records only fund facts and is retained 365 days (reconciliation/forensics); runtime logs 30 days. -->
<configuration>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [PAY] [%X{traceId:-}] [%X{uid:-}] %logger{24} - %msg%n"/>
    <property name="LOG_HOME" value="logs"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/app-pay.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/app-pay.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Fund audit: JSONL written by PayAuditLogger, one fund fact per line -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/pay-audit.jsonl</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/pay-audit.%d{yyyy-MM-dd}.%i.jsonl.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>365</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="PAY_AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <!-- The Alipay SDK's built-in logs fully duplicate the adapter's business logs: biz.err fully dumps the
         response payload as ERROR for every "business failure" response (e.g. ACQ.TRADE_NOT_EXIST when polling
         an unpaid order), biz.info dumps full parameters (including Chinese product names) for every successful
         call, and comm.err dumps a full HTML page + stack trace for transport-layer errors (intermittent sandbox
         gateway 404s, etc.): all three are noise: after catching, the adapter already logs a single-line
         summary at ERROR (with traceId/uid). Disable them all; no real exception loses its signal. -->
    <logger name="sdk.biz.err" level="off"/>
    <logger name="sdk.biz.info" level="off"/>
    <logger name="sdk.comm.err" level="off"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>
</configuration>
