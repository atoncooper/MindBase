<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- Membership handwritten SQL: only statements that MyBatis-Plus BaseMapper/LambdaWrapper cannot express. -->
<mapper namespace="com.mindbase.pay.mapper.PayMembershipMapper">

    <!-- Lock the membership row before computing the extension (pessimistic lock); serializes concurrent delivery for the same user -->
    <select id="selectByUidForUpdate" resultType="com.mindbase.pay.model.PayMembership">
        SELECT *
        FROM pay_membership
        WHERE uid = #{uid}
          FOR UPDATE
    </select>
</mapper>
