# ============================================================
# app-task 独立部署覆盖项（docker-compose.yml 配套）
# ============================================================
# 复制为 .env 后按需填写。在 app-task/ 下执行 docker compose 时自动
# 加载：用于 compose 文件的 ${} 替换，并注入 app-task 容器环境变量
# （APPTASK__* 变量直达 Go 二进制配置层）。
# 完整配置项参考：app-task/default.yaml 与项目根 .env.example 的
# APPTASK 段；凡是二进制接受的 APPTASK__SECTION__KEY 都可写在这里。

# ---- 邮件（Resend）----
APPTASK__EMAIL__API_KEY=
# APPTASK__EMAIL__FROM=MindBase <onboarding@resend.dev>

# ---- WebUI 控制台（http://localhost:8001/）----
# 已启用登录门禁（独立 /login 登录页 + HttpOnly 会话 Cookie）。
# 下面是与 docker-compose.yml 一致的默认开发令牌；⚠️ 生产必须改为强随机值。
APPTASK__WEBUI__TOKEN=b5ff9f9853fc6b26285c8177ac7282c4

# ---- 自带 MySQL（app-task-mysql 容器）----
APPTASK_MYSQL_ROOT_PASSWORD=root123
APPTASK_MYSQL_USER=app_task
APPTASK_MYSQL_PASSWORD=app-task

# ---- 服务 ----
APP_TASK_PORT=8001
# APPTASK_IMAGE=app-task:local

# ---- 其他（默认值见 default.yaml）----
# APPTASK__TIMEZONE=Asia/Shanghai
# APPTASK__LOG__LEVEL=info
# APPTASK__LOG__FORMAT=text
# APPTASK__LOG__OUTPUT=both     # compose 已固定，改这里不生效
