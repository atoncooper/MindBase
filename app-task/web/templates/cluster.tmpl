{{define "content"}}
{{if .Instructions}}
<div class="panel panel-default">
  <div class="panel-heading panel-head"><span class="panel-title">加入指引 — {{.JoinedID}}</span><span class="muted">复制到新节点执行；RDBMS 连接串请从密钥渠道获取（此处为占位符）</span></div>
  <div class="panel-body">
    <pre class="code" id="join-instructions">{{.Instructions}}</pre>
  </div>
  <div class="panel-note">节点首次心跳后自动从「待接入」转为「存活」。预登记 24 小时无人接入将被自动清理，可重新生成。</div>
</div>
{{end}}

<div class="toolbar">
  <div></div>
  <div class="toolbar-right">
    {{if .User.IsAdmin}}
    <button class="btn btn-primary" type="button" data-modal-open="cluster-join-modal">加入节点</button>
    {{end}}
  </div>
</div>

<div class="panel panel-default">
  <div class="panel-heading panel-head"><span class="panel-title">节点名册</span><span class="muted">心跳 3 次失联即判死，其认领被其他节点即时接管</span></div>
  <table class="table table-striped table-hover data">
    <thead><tr><th>node_id</th><th>主机</th><th>版本</th><th>权重</th><th>启动时间</th><th>最近心跳</th><th>认领中</th><th>状态</th></tr></thead>
    <tbody>
    {{range .Nodes}}
      <tr>
        <td class="mono-cell">{{.NodeID}}{{if .Self}} <span class="label label-primary">本机</span>{{end}}</td>
        <td>{{.Hostname}}</td>
        <td>{{.Version}}</td>
        <td>{{.Weight}}</td>
        <td>{{.StartedAt}}</td>
        <td>{{.LastHeartbeat}}</td>
        <td>{{.Claims}}</td>
        <td><span class="label {{if .Alive}}label-success{{else}}label-danger{{end}}">{{if .Alive}}存活{{else}}失联{{end}}</span></td>
      </tr>
    {{else}}
      <tr><td colspan="8" class="empty">名册为空</td></tr>
    {{end}}
    </tbody>
  </table>
</div>

{{if .PendingNodes}}
<div class="panel panel-default">
  <div class="panel-heading panel-head"><span class="panel-title">待接入节点</span><span class="muted">已预登记、等待新节点首次心跳</span></div>
  <table class="table table-striped table-hover data">
    <thead><tr><th>node_id</th><th>主机</th><th>权重</th><th>登记时间</th><th>状态</th></tr></thead>
    <tbody>
    {{range .PendingNodes}}
      <tr>
        <td class="mono-cell">{{.NodeID}}</td>
        <td>{{.Hostname}}</td>
        <td>{{.Weight}}</td>
        <td>{{.StartedAt}}</td>
        <td><span class="label label-warning">待接入</span></td>
      </tr>
    {{end}}
    </tbody>
  </table>
</div>
{{end}}

{{if .User.IsAdmin}}
<div class="modal fade" id="cluster-join-modal" tabindex="-1" role="dialog" aria-labelledby="cluster-join-title">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-modal-close aria-label="关闭"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="cluster-join-title">加入节点</h4>
      </div>
      <form method="post" action="/console/cluster/join">
        <div class="modal-body">
          <div class="form-group">
            <label>node_id（2–64 字符，将成为 task.owner）</label>
            <input name="node_id" class="form-control mono" required maxlength="64" placeholder="如 worker-3">
          </div>
          <div class="form-group">
            <label>权重（默认 1；worker 节点建议高于 manager）</label>
            <input type="number" name="weight" class="form-control" value="1" min="1" max="64" step="1">
          </div>
          <div class="form-group">
            <label>主机名（可选，便于溯源）</label>
            <input name="hostname" class="form-control" maxlength="128" placeholder="如 prod-worker-3">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-modal-close>取消</button>
          <button class="btn btn-primary" type="submit">预登记并生成指引</button>
        </div>
      </form>
    </div>
  </div>
</div>
{{end}}
{{end}}
