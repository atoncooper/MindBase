{{define "content"}}
<div class="detail-top">
  <a class="btn btn-default btn-sm" href="/console">← 返回仪表盘</a>
  <span class="id-chip">{{.Username}}</span>
</div>

<div class="panel panel-default">
  <div class="panel-heading panel-head"><span class="panel-title">修改自己的登录密码</span></div>
  <div class="panel-body">
    <form method="post" action="/console/password" class="form-horizontal" style="max-width:560px">
      <div class="form-group">
        <label class="col-sm-3 control-label" for="old-password">当前密码</label>
        <div class="col-sm-9">
          <input type="password" class="form-control" id="old-password" name="old_password" required autocomplete="current-password">
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-3 control-label" for="new-password">新密码（8–128 位）</label>
        <div class="col-sm-9">
          <input type="password" class="form-control" id="new-password" name="new_password" required minlength="8" maxlength="128" autocomplete="new-password">
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-3 control-label" for="new-password2">确认新密码</label>
        <div class="col-sm-9">
          <input type="password" class="form-control" id="new-password2" name="new_password2" required minlength="8" maxlength="128" autocomplete="new-password">
        </div>
      </div>
      <div class="form-group">
        <div class="col-sm-offset-3 col-sm-9">
          <button type="submit" class="btn btn-primary">更新密码</button>
        </div>
      </div>
    </form>
  </div>
  <div class="panel-note">需要验证当前密码；修改后当前会话保持有效，其他设备需重新登录（会话在进程内存中，重启后全部失效）。</div>
</div>

<script>
document.querySelector('form').addEventListener('submit', function (e) {
  var n1 = this.querySelector('[name=new_password]').value;
  var n2 = this.querySelector('[name=new_password2]').value;
  if (n1 !== n2) { e.preventDefault(); alert('两次输入的新密码不一致'); }
});
</script>
{{end}}
