{{define "content"}}
<div class="toolbar">
  <div></div>
  <div class="toolbar-right">
    <div class="dropdown" style="display:inline-block">
      <button class="btn btn-default" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        示例脚本 <span class="caret"></span>
      </button>
      <ul class="dropdown-menu dropdown-menu-right">
        <li class="dropdown-header">从内置示例创建新脚本</li>
        <li><a href="/console/scripts/new?example=http-get-json">HTTP GET + JSON 解析</a></li>
        <li><a href="/console/scripts/new?example=http-post-auth">POST + 密钥凭据</a></li>
        <li><a href="/console/scripts/new?example=http-req-full">ctx.http_req 全参数</a></li>
        <li><a href="/console/scripts/new?example=payload-retry">payload + 失败重试</a></li>
      </ul>
    </div>
    <a class="btn btn-primary" href="/console/scripts/new">＋ 新建脚本</a>
  </div>
</div>

<div class="panel panel-default">
  <table class="table table-striped table-hover data">
    <thead><tr><th>script_id</th><th>名称</th><th>描述</th><th>版本</th><th>启用</th><th>更新时间</th><th class="op-col">操作</th></tr></thead>
    <tbody>
    {{range .Items}}
      <tr>
        <td class="mono-cell"><a href="/console/scripts/{{.ScriptID}}">{{.ScriptID}}</a></td>
        <td>{{.Name}}</td>
        <td title="{{.Description}}">{{.DescriptionShort}}</td>
        <td>v{{.Version}}</td>
        <td><span class="label {{if .Enabled}}label-success{{else}}label-default{{end}}">{{if .Enabled}}启用{{else}}停用{{end}}</span></td>
        <td>{{.UpdatedAt}}</td>
        <td class="op-cell">
          <form method="post" action="/console/scripts/{{.ScriptID}}/toggle" class="inline-form">
            <input type="hidden" name="enabled" value="{{if .Enabled}}0{{else}}1{{end}}">
            <button class="btn btn-default btn-xs" type="submit">{{if .Enabled}}停用{{else}}启用{{end}}</button>
          </form>
        </td>
      </tr>
    {{else}}
      <tr><td colspan="7" class="empty">暂无脚本，点击右上角「新建脚本」创建</td></tr>
    {{end}}
    </tbody>
  </table>
</div>
{{end}}
