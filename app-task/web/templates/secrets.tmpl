{{define "content"}}
{{if not .Enabled}}
<div class="alert alert-danger page-alert-static">
  密钥库未启用：缺少环境变量 <span class="mono">SECURITY__API_KEY_ENCRYPTION_KEY</span>（base64 的 32 字节密钥，与主 app 共用同一变量）。配置后重启 app-task。
</div>
{{end}}

<div class="panel panel-default">
  <div class="panel-heading panel-head">
    <span class="panel-title">密钥管理 <span class="muted">（{{len .Items}}/{{.MaxCount}}）</span></span>
    <button class="btn btn-primary btn-sm" type="button" data-modal-open="secret-create-modal" {{if not .Enabled}}disabled{{end}}>添加密钥</button>
  </div>
  <table class="table table-striped table-hover data">
    <thead><tr><th>secret_id</th><th>名称</th><th>描述</th><th>创建人</th><th>更新人</th><th>更新时间</th><th class="op-col">操作</th></tr></thead>
    <tbody>
    {{range .Items}}
      <tr>
        <td class="mono-cell" title="{{.SecretID}}">{{.SecretID}}</td>
        <td class="mono-cell strong">{{.Name}}</td>
        <td title="{{.Description}}">{{.Description}}</td>
        <td>{{.CreatedBy}}</td>
        <td>{{.UpdatedBy}}</td>
        <td>{{.UpdatedAt}}</td>
        <td class="op-cell">
          <button class="btn btn-default btn-xs" type="button" data-modal-open="secret-update-modal"
                  data-secret-id="{{.SecretID}}" data-name="{{.Name}}" data-desc="{{.Description}}">更新</button>
          <form method="post" action="/console/secrets/{{.SecretID}}/delete" class="inline-form"
                onsubmit="return confirm('确认删除密钥 {{.Name}}？使用它的 Lua 脚本将立即失败。')">
            <button class="btn btn-danger btn-xs" type="submit">删除</button>
          </form>
        </td>
      </tr>
    {{else}}
      <tr><td colspan="7" class="empty">暂无密钥{{if .Enabled}}，点击右上角「添加密钥」创建{{end}}</td></tr>
    {{end}}
    </tbody>
  </table>
  <div class="panel-note">secret_id 是每条密钥的独立标识（更新/删除按 ID 寻址）；名称全局唯一且是脚本读取句柄：local token = ctx.secret('name')，配合 ctx.http_req({headers = {Authorization = 'Bearer ' .. token}}) 调用外部 API；值经 AES-256-GCM 加密存储，明文永不回显，日志自动脱敏。</div>
</div>

{{if .Enabled}}
<div class="modal fade" id="secret-create-modal" tabindex="-1" role="dialog" aria-labelledby="secret-create-title">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-modal-close aria-label="关闭"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="secret-create-title">添加密钥</h4>
      </div>
      <form method="post" action="/console/secrets">
        <div class="modal-body">
          <div class="form-group">
            <label>名称（小写字母开头的 [a-z0-9_]，全局唯一）</label>
            <input name="name" class="form-control mono" required maxlength="64" placeholder="如 github_token">
          </div>
          <div class="form-group">
            <label>描述</label>
            <input name="description" class="form-control" maxlength="255" placeholder="用途说明">
          </div>
          <div class="form-group">
            <label>密钥值（必填，≤8KB；保存后不可再查看）</label>
            <textarea name="value" class="form-control mono" required rows="4" style="resize:vertical"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-modal-close>取消</button>
          <button class="btn btn-primary" type="submit">保存</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="secret-update-modal" tabindex="-1" role="dialog" aria-labelledby="secret-update-title">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-modal-close aria-label="关闭"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="secret-update-title">更新密钥</h4>
      </div>
      <form method="post" action="/console/secrets/update">
        <div class="modal-body">
          <input type="hidden" name="secret_id" id="secret-update-id">
          <div class="form-group">
            <label>名称（只读，脚本读取句柄不可改）</label>
            <input id="secret-update-title" class="form-control mono" readonly>
          </div>
          <div class="form-group">
            <label>描述</label>
            <input name="description" id="secret-update-desc" class="form-control" maxlength="255">
          </div>
          <div class="form-group">
            <label>新密钥值（留空 = 保持不变）</label>
            <textarea name="value" rows="4" class="form-control mono" style="resize:vertical" placeholder="留空则仅更新描述"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-modal-close>取消</button>
          <button class="btn btn-primary" type="submit">更新</button>
        </div>
      </form>
    </div>
  </div>
</div>
{{end}}
{{end}}
