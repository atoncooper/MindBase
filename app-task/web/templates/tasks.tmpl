{{define "content"}}
<div class="toolbar">
  <ul class="nav nav-pills filter-pills">
    <li role="presentation" {{if eq .Status ""}}class="active"{{end}}><a href="/console/tasks">全部</a></li>
    <li role="presentation" {{if eq .Status "pending"}}class="active"{{end}}><a href="/console/tasks?status=pending">pending</a></li>
    <li role="presentation" {{if eq .Status "dispatching"}}class="active"{{end}}><a href="/console/tasks?status=dispatching">dispatching</a></li>
    <li role="presentation" {{if eq .Status "running"}}class="active"{{end}}><a href="/console/tasks?status=running">running</a></li>
    <li role="presentation" {{if eq .Status "completed"}}class="active"{{end}}><a href="/console/tasks?status=completed">completed</a></li>
    <li role="presentation" {{if eq .Status "failed"}}class="active"{{end}}><a href="/console/tasks?status=failed">failed</a></li>
  </ul>
  <div class="toolbar-right">
    <a class="btn btn-primary" href="/console/tasks/new">＋ 新建任务</a>
  </div>
</div>

<div class="panel panel-default">
  <table class="table table-striped table-hover data">
    <thead><tr>
      <th>task_id</th><th>uid</th><th>类型</th><th>状态</th><th>触发时间</th><th>cron</th><th>执行器</th><th>重试</th>
    </tr></thead>
    <tbody>
    {{range .Items}}
      <tr>
        <td class="mono-cell"><a href="/console/tasks/{{.TaskID}}">{{.TaskIDShort}}</a></td>
        <td>{{.UID}}</td>
        <td>{{.TaskType}}</td>
        <td><span class="label label-{{.StatusClass}}">{{.StatusText}}</span></td>
        <td>{{.TriggerTime}}</td>
        <td class="mono-cell">{{.CronExpr}}</td>
        <td title="{{.ExecutorURL}}">{{.ExecutorShort}}</td>
        <td>{{.RetryCount}}/{{.MaxRetry}}</td>
      </tr>
    {{else}}
      <tr><td colspan="8" class="empty">暂无任务</td></tr>
    {{end}}
    </tbody>
  </table>
  <div class="panel-footer page-pagination">
    <span>共 {{.Nav.Total}} 条 · 第 {{.Nav.From}}-{{.Nav.To}} 条</span>
    <ul class="pagination pagination-sm">
      <li {{if not .Nav.PrevURL}}class="disabled"{{end}}><a href="{{if .Nav.PrevURL}}{{.Nav.PrevURL}}{{else}}#{{end}}">上一页</a></li>
      <li {{if not .Nav.NextURL}}class="disabled"{{end}}><a href="{{if .Nav.NextURL}}{{.Nav.NextURL}}{{else}}#{{end}}">下一页</a></li>
    </ul>
  </div>
</div>
{{end}}
