{{define "content"}}
<div class="panel panel-default">
  <div class="panel-heading panel-head">
    <span class="panel-title">控制台账户</span>
    <button class="btn btn-primary btn-sm" type="button" data-modal-open="user-modal">添加账户</button>
  </div>

  <table class="table table-striped table-hover data">
    <thead><tr><th>用户 ID</th><th>用户名</th><th>角色</th><th>创建时间</th><th class="op-col">操作</th></tr></thead>
    <tbody>
    {{range .Items}}
      <tr>
        <td class="mono-cell">{{.UserID}}</td>
        <td class="strong">{{.Username}}{{if .IsSelf}} <span class="label label-primary">你</span>{{end}}</td>
        <td><span class="label {{if .IsAdmin}}label-primary{{else}}label-default{{end}}">{{.Role}}</span></td>
        <td>{{.CreatedAt}}</td>
        <td class="op-cell">
          <form method="post" action="/console/users/{{.UserID}}/password" class="row-form">
            <input type="password" name="password" required minlength="8" maxlength="128" placeholder="新密码（≥8 位）" autocomplete="new-password">
            <button class="btn btn-default btn-xs" type="submit">改密</button>
          </form>
          {{if .Deletable}}
          <form method="post" action="/console/users/{{.UserID}}/delete" class="row-form" onsubmit="return confirm('确认删除账户 {{.Username}}？')">
            <button class="btn btn-danger btn-xs" type="submit">删除</button>
          </form>
          {{end}}
        </td>
      </tr>
    {{else}}
      <tr><td colspan="5" class="empty">暂无账户</td></tr>
    {{end}}
    </tbody>
  </table>
  <div class="panel-note">admin：全部权限（含账户管理）；member：可操作控制台但不能管理账户。不能删除自己或最后一个 admin。</div>
</div>

<div class="modal fade" id="user-modal" tabindex="-1" role="dialog" aria-labelledby="user-modal-title">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-modal-close aria-label="关闭"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="user-modal-title">添加账户</h4>
      </div>
      <form method="post" action="/console/users">
        <div class="modal-body">
          <div class="form-group">
            <label>用户名（2–64 字符）</label>
            <input name="username" class="form-control" required minlength="2" maxlength="64" placeholder="如 zhang">
          </div>
          <div class="form-group">
            <label>角色</label>
            <select name="role" class="form-control">
              <option value="member">member（可操作控制台）</option>
              <option value="admin">admin（含账户管理）</option>
            </select>
          </div>
          <div class="form-group">
            <label>密码（至少 8 位）</label>
            <input type="password" name="password" class="form-control" required minlength="8" maxlength="128" autocomplete="new-password">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-modal-close>取消</button>
          <button class="btn btn-primary" type="submit">创建</button>
        </div>
      </form>
    </div>
  </div>
</div>
{{end}}
