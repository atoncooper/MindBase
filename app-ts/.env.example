# app-ts environment variable sample (secrets/sensitive values only; ordinary config goes through env vars or config.ts defaults)
# Copy to .env and fill in real values; .env must not be committed.

# Higress AI gateway consumer key (LLM / embedding / rerank auth)
AI_GATEWAY__API_KEY=

# Milvus token (when auth is enabled)
MILVUS__TOKEN=

# app-board-mcp service-mode apikey (APISIX_CONSUMER_KEY; the board agent calls board capabilities via MCP)
BOARD_MCP__API_KEY=

# MongoDB connection string (chat history persistence; empty = fall back to the in-memory implementation)
MONGO__URI=

# OCR (image document recognition): calls a vision model via the gateway; the key
# reuses AI_GATEWAY__API_KEY unless OCR runs on a separate gateway/provider
OCR__API_KEY=

# DeepSeek official web Search/Fetch API (api-docs.deepseek.com/zh-cn/guides/search);
# powers the web_search engine chain (first) and fetch_webpage (primary fetcher,
# local crawler as fallback). Empty = disabled.
DEEPSEEK_API_KEY=
