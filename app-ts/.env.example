# app-ts local env sample — copy to app-ts/.env (gitignored).
#
# Model credential: ONLY AI_GATEWAY__API_KEY. Do NOT add per-model/provider
# keys (OPENAI_API_KEY / GLM_* / OCR__API_KEY / ...): LLM, embedding, rerank
# and OCR all use the gateway.
#
# Ordinary config (endpoints/model names/timeouts) belongs in
# config/default.yaml; for host-run app-ts you can override service endpoints
# in config/local.yaml (gitignored). Compose containers get the repo-root .env
# via env_file and do not use this file.

# ——— required ———
AI_GATEWAY__API_KEY=
AI_GATEWAY__BASE_URL=http://127.0.0.1:18080/v1
APISIX_CONSUMER_KEY=
MONGO__URI=mongodb://user:pass@127.0.0.1:27017/?authSource=admin
REDIS__URL=redis://:password@127.0.0.1:6379/1
MILVUS__ADDRESS=127.0.0.1:19530

# ——— optional capabilities ———
# Milvus token (only when Milvus auth is enabled)
MILVUS__TOKEN=
# MinIO: chat images / session-document originals / skill zips (optional)
MINIO__ENDPOINT=http://127.0.0.1:9000
MINIO__ACCESS_KEY=
MINIO__SECRET_KEY=
MINIO__BUCKET=drive-videos
# app-content-mcp service mode apikey — usually the same value as APISIX_CONSUMER_KEY
CONTENT_MCP__API_KEY=

# ——— optional tools / observability ———
# DEEPSEEK_API_KEY=          # web_search / fetch_webpage only (NOT a model key)
# TAVILY_API_KEY=
# SEARXNG_URL=
# SKILL_STORE_API_KEY=       # GitHub PAT for skill store rate limit
# QUOTA__GATEWAY_USAGE_TOKEN=
# ACADEMIC__LITERATURE__MAILTO=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=MindBase-ts
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_TRACING=true
