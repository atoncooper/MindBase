{
  "name": "mindbase-app-ts",
  "version": "0.1.0",
  "private": true,
  "description": "MindBase agent + RAG core, rewritten in TypeScript (standalone Node service)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "reingest:video-kb": "tsx scripts/reingest-video-kb.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^10.1.2",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@zilliz/milvus2-sdk-node": "^2.5.0",
    "ai": "^5.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "ioredis": "^5.11.1",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "minio": "^8.0.7",
    "mongodb": "^7.7.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "@opentelemetry/api": "^1.9.1"
  }
}
