# ====== frontendv2: Next.js 16 (China-optimized) ======
# Based on frontendv2/Dockerfile with all registries routed through
# China-accessible mirrors.  Build context MUST be frontendv2/ (../../frontendv2).

# ----- Stage 1: build -----
FROM node:22-alpine AS builder

# ── Alpine packages: Aliyun mirror ──────────────────────────────────
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

WORKDIR /app

ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_APISIX_HOST=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_APISIX_HOST=$NEXT_PUBLIC_APISIX_HOST

# Install dependencies via npmmirror (China npm registry).
COPY package.json package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com

# Copy source and build
COPY . .
RUN npm run build

# ----- Stage 2: run -----
FROM node:22-alpine AS runner

# ── Alpine packages: Aliyun mirror ──────────────────────────────────
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN addgroup -g 1001 -S appgroup && adduser -S appuser -u 1001 -G appgroup

COPY --from=builder --chown=appuser:appgroup /app/.next/standalone ./
COPY --from=builder --chown=appuser:appgroup /app/.next/static ./.next/static
COPY --from=builder --chown=appuser:appgroup /app/public ./public

USER appuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
