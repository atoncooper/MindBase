# Dependencies (installed inside the image via `npm ci`)
node_modules

# Build output (regenerated by `next build`)
.next
out

# Version control & metadata
.git
.gitignore
.gitattributes

# Local env files (must never bake into the image)
.env
.env.*
!.env.example

# Editor / OS noise
.vscode
.idea
.DS_Store
*.swp

# Logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# Docker own files (no need inside the build context)
Dockerfile
.dockerignore
.docker
