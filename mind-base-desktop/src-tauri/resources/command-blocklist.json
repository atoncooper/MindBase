{
  "version": 1,
  "patterns": [
    {
      "match": "rm -rf /",
      "reason": "递归删除根目录（rm -rf / 或绝对路径目标）"
    },
    {
      "match": "rm -fr /",
      "reason": "递归删除根目录（rm -fr / 或绝对路径目标）"
    },
    {
      "match": "rm -r -f /",
      "reason": "递归删除根目录（rm -r -f /）"
    },
    {
      "match": "rm -f -r /",
      "reason": "递归删除根目录（rm -f -r /）"
    },
    {
      "match": "rm -rf --no-preserve-root",
      "reason": "强制递归删除根目录（--no-preserve-root）"
    },
    {
      "match": "mkfs",
      "token": true,
      "reason": "格式化文件系统（mkfs）"
    },
    {
      "match": "wipefs",
      "token": true,
      "reason": "抹除文件系统签名（wipefs）"
    },
    {
      "match": "fdisk",
      "token": true,
      "reason": "修改磁盘分区表（fdisk）"
    },
    {
      "match": "parted",
      "token": true,
      "reason": "修改磁盘分区表（parted）"
    },
    {
      "match": "dd if=/dev/zero",
      "reason": "用零覆盖磁盘（dd if=/dev/zero）"
    },
    {
      "match": ":(){",
      "reason": "fork 炸弹（:(){ :|:& };:）"
    },
    {
      "match": "shutdown",
      "token": true,
      "reason": "关闭或重启服务器（shutdown）"
    },
    {
      "match": "reboot",
      "token": true,
      "reason": "重启服务器（reboot）"
    },
    {
      "match": "poweroff",
      "token": true,
      "reason": "关闭服务器电源（poweroff）"
    },
    {
      "match": "halt",
      "token": true,
      "reason": "停机（halt）"
    },
    {
      "match": "chmod -R 777 /",
      "reason": "把根目录权限改为 777（chmod -R 777 /）"
    },
    {
      "match": "chown -R /",
      "reason": "递归改变根目录属主（chown -R /）"
    },
    {
      "match": "mv /*",
      "reason": "移动根目录下的系统路径（mv /*）"
    },
    {
      "match": "> /dev/sd",
      "reason": "直接写入磁盘设备（> /dev/sd*）"
    },
    {
      "match": "crontab -r",
      "reason": "清空全部定时任务（crontab -r）"
    }
  ]
}
